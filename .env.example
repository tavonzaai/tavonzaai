# ==========================================
# Environment Variables Blueprint
# ==========================================

NODE_ENV=development
APP_ENV=dev

# Ports
API_PORT=3000
REALTIME_PORT=3001
WORKER_PORT=3002
AI_PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/platform_dev?schema=public

# Redis / Valkey
REDIS_URL=redis://localhost:6379

# AWS Infrastructure
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# S3
S3_BUCKET_ASSETS=platform-dev-assets
S3_BUCKET_REPORTS=platform-dev-reports

# SQS Queues
SQS_OUTBOX_QUEUE_URL=
SQS_NOTIFICATIONS_QUEUE_URL=

# Authentication & JWT
JWT_SECRET=replace-with-secure-secret-in-vault
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
