# ==========================================
# Environment Variables Blueprint
# ==========================================

NODE_ENV=development
APP_ENV=dev

# Ports
API_PORT=3000
REALTIME_PORT=3001
WORKER_PORT=3002
AI_PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/platform_dev?schema=public

# Redis / Valkey
REDIS_URL=redis://localhost:6379

# AWS Infrastructure / Local S3 (MinIO)
AWS_REGION=eu-west-2
# For local dev with MinIO, use minioadmin / minioadmin
# For prod / live, supply your real AWS IAM credentials or leave empty if using ECS/EC2 IAM Role
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_SESSION_TOKEN=

# AWS SES & Email Dispatch Settings
SMTP_HOST=email-smtp.eu-west-2.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@tavonza.com
SMTP_SECURE=false
MAIL_FROM_ADDRESS=noreply@tavonza.com
SES_CONFIGURATION_SET=

# Object Storage (S3 / MinIO)
# Local Dev (MinIO): S3_ENDPOINT=http://localhost:9000 and S3_FORCE_PATH_STYLE=true
# Prod / Live (AWS S3): Leave S3_ENDPOINT empty, S3_FORCE_PATH_STYLE=false
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_BUCKET_NAME=tavonzaai-dev-storage-bucket
AWS_S3_BUCKET=tavonzaai-dev-storage-bucket
S3_BUCKET_ASSETS=tavonzaai-dev-storage-bucket
S3_BUCKET_REPORTS=platform-dev-reports
# Optional CDN URL for public distribution (e.g. CloudFront)
CDN_BASE_URL=

# SQS Queues
SQS_OUTBOX_QUEUE_URL=
SQS_NOTIFICATIONS_QUEUE_URL=

# Authentication & JWT
JWT_SECRET=replace-with-secure-secret-in-vault
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Frontend Ports
CUSTOMER_PORT=3100
STAFF_PORT=3101
ADMIN_PORT=3102

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100,http://localhost:3101,http://localhost:3102

