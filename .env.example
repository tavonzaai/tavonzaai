# ==============================================================================
# Environment Variables Blueprint (.env.example)
# ==============================================================================

NODE_ENV=development
APP_ENV=dev

# Application Ports
PORT=3000
API_PORT=3000
REALTIME_PORT=3001
WORKER_PORT=3002
AI_PORT=8000

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database
# Local: postgresql://postgres:postgres@localhost:5432/platform_dev?schema=public
# Live:  postgresql://tavonzaai_user:<password>@tavonzaai-live-db.czoa68sggx7i.eu-west-2.rds.amazonaws.com:5432/tavonzaai_db?schema=public&sslmode=require
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://tavonzaai_user:tavonzaaiPass2026Live@tavonzaai-live-db.czoa68sggx7i.eu-west-2.rds.amazonaws.com:5432/tavonzaai_db?schema=public&sslmode=require
DATABASE_PASSWORD=tavonzaaiPass2026Live
DATABASE_SSL=true

# ------------------------------------------------------------------------------
# 2. Redis / Valkey (Direct Public Access)
# ------------------------------------------------------------------------------
REDIS_URL=redis://:tavonzaaiPass2026Live@redis.tavonza.com:6379
REDIS_HOST=redis.tavonza.com
REDIS_PORT=6379
REDIS_PASSWORD=tavonzaaiPass2026Live

# ------------------------------------------------------------------------------
# 3. AWS S3 Storage (tavonzaai-live-storage-bucket)
# ------------------------------------------------------------------------------
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=AKIAYEDJYKS5CZOF723K
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_BUCKET_NAME=tavonzaai-live-storage-bucket
AWS_S3_BUCKET=tavonzaai-live-storage-bucket
S3_BUCKET_ASSETS=tavonzaai-live-storage-bucket
S3_BUCKET_REPORTS=tavonzaai-live-storage-bucket
CDN_BASE_URL=https://tavonzaai-live-storage-bucket.s3.eu-west-2.amazonaws.com

# ------------------------------------------------------------------------------
# 4. AWS Infrastructure Credentials
# ------------------------------------------------------------------------------
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=AKIAYEDJYKS5CZOF723K
AWS_SECRET_ACCESS_KEY=your-s3-secret-access-key
AWS_SESSION_TOKEN=

# ------------------------------------------------------------------------------
# 5. AWS Simple Email Service (SES) / SMTP
# ------------------------------------------------------------------------------
SMTP_HOST=email-smtp.eu-west-2.amazonaws.com
SMTP_PORT=587
SMTP_USER=AKIAYEDJYKS5EZKIM7KB
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@tavonza.com
SMTP_SECURE=false
MAIL_FROM_ADDRESS=noreply@tavonza.com
SES_CONFIGURATION_SET=tavonzaai-live-email-config-set

# ------------------------------------------------------------------------------
# 6. SQS Queues (Leave blank for local in-memory/mock)
# ------------------------------------------------------------------------------
SQS_OUTBOX_QUEUE_URL=
SQS_NOTIFICATIONS_QUEUE_URL=

# ------------------------------------------------------------------------------
# 7. JWT Authentication Secrets
# ------------------------------------------------------------------------------
JWT_SECRET=dev-jwt-secret-for-local-development-only-12345
JWT_REFRESH_SECRET=dev-refresh-secret-for-local-development-only-12345
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# ------------------------------------------------------------------------------
# 8. Frontend Application Ports & CORS
# ------------------------------------------------------------------------------
CUSTOMER_PORT=3100
STAFF_PORT=3101
ADMIN_PORT=3102
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100,http://localhost:3101,http://localhost:3102
