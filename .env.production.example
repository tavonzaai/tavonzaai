# ==============================================================================
# PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# Copy this to .env.production to configure production/live environments.
# To sync this file to AWS Secrets Manager, run:
#   ./scripts/sync-env-to-secrets.sh live .env.production
#   ./scripts/sync-env-to-secrets.sh prod .env.production
# ==============================================================================

NODE_ENV=production
APP_ENV=production

# Application Ports
PORT=5000
API_PORT=5000
REALTIME_PORT=3001
WORKER_PORT=3002
AI_PORT=8000

# Production Database & Caching (AWS RDS & Valkey/ElastiCache)
DATABASE_URL=postgresql://user:password@endpoint:5432/dbname?schema=public&sslmode=require
DATABASE_PASSWORD=your-rds-password
REDIS_URL=rediss://endpoint:6379

# Dedicated AWS S3 Storage (tavonzaai-<env>-s3-user)
S3_BUCKET_NAME=tavonzaai-live-storage-bucket
AWS_S3_BUCKET=tavonzaai-live-storage-bucket
S3_ACCESS_KEY_ID=AKIA...
S3_SECRET_ACCESS_KEY=...
AWS_REGION=eu-west-2
# Note: S3_ENDPOINT and S3_FORCE_PATH_STYLE are empty for native AWS S3
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
CDN_BASE_URL=

# Dedicated AWS SES Email Sending (tavonzaai-<env>-ses-smtp-user)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
SMTP_HOST=email-smtp.eu-west-2.amazonaws.com
SMTP_PORT=587
SMTP_USER=AKIA...
SMTP_PASS=...
SMTP_FROM=noreply@tavonza.com
SMTP_SECURE=false
MAIL_FROM_ADDRESS=noreply@tavonza.com
SES_CONFIGURATION_SET=tavonzaai-live-email-config-set

# Production Authentication & JWT Secrets
JWT_SECRET=secure-production-jwt-secret-here
JWT_REFRESH_SECRET=secure-production-refresh-secret-here
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Company Info & Third Party Keys
COMPANY_NAME=tavonzaai
THIRD_PARTY_API_KEYS=
