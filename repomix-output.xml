// ============================================================================
// Role & Permission Management Controller
// ============================================================================

import {
  Controller,
  Get,
  Post,
  Patch,
  Delete,
  Param,
  Body,
  Query,
  UseGuards,
  HttpCode,
  HttpStatus,
  ParseUUIDPipe,
} from '@nestjs/common';
import {
  ApiTags,
  ApiOperation,
  ApiBearerAuth,
  ApiOkResponse,
  ApiCreatedResponse,
  ApiParam,
  ApiQuery,
} from '@nestjs/swagger';
import { JwtAuthGuard } from '../../../common/guards/jwt-auth.guard';
import { PermissionsGuard } from '../../../common/guards/permissions.guard';
import { RequirePermissions } from '../../../common/decorators/require-permissions.decorator';
import { CurrentUser } from '../../../common/decorators/current-user.decorator';
import { Permission } from '@/authorization';
import { RoleService } from '../services/role.service';
import {
  CreateRoleDto,
  UpdateRoleDto,
  AssignUserRoleDto,
  RoleResponseDto,
  RoleDetailResponseDto,
} from '../dto/role.dto';
import { ApiStandardErrors } from '../../../common/swagger';

@ApiTags('Authorization | Roles & Permissions')
@Controller('authorization')
@UseGuards(JwtAuthGuard, PermissionsGuard)
@ApiBearerAuth('access-token')
@ApiStandardErrors(400, 401, 403, 500)
export class RoleController {
  constructor(private readonly roleService: RoleService) {}

  // ── Current Authenticated User Role & Capabilities ─────────────────────────

  @Get('me')
  @ApiOperation({
    summary: 'Get assigned dynamic role and effective permissions for current authenticated user',
    description: 'Resolves caller’s single assigned dynamic role from user_roles and effective permission array directly from the database.',
  })
  async getMyRole(@CurrentUser() user: any) {
    const role = await this.roleService.getUserRole(user.sub);
    const live = await this.roleService.getEffectivePermissions(user.sub);
    return {
      userId: user.sub,
      email: user.email,
      globalRole: user.role,
      role,
      permissions: live.permissions,
      scopes: live.scopes,
    };
  }

  // ── Permissions Catalog ───────────────────────────────────────────────────

  @Get('permissions')
  @RequirePermissions(Permission.PERMISSIONS_READ)
  @ApiOperation({
    summary: 'List all available system permissions',
    description: 'Route Guard: Protected by JwtAuthGuard + PermissionsGuard requiring [permissions:read]. Returns catalog of all declared module permissions grouped by module_name.',
  })
  async getAllPermissions() {
    return this.roleService.getAllPermissions();
  }

  // ── Roles Management ──────────────────────────────────────────────────────

  @Get('roles')
  @RequirePermissions(Permission.ROLES_READ)
  @ApiOperation({
    summary: 'List all roles with assignment and permission metrics',
    description: 'Route Guard: Protected by JwtAuthGuard + PermissionsGuard requiring [roles:read]. Returns all system and custom roles with user count and permission count. Supports optional search filtering.',
  })
  @ApiQuery({ name: 'search', required: false, type: String, description: 'Optional search text to filter by role name or slug', example: 'waiter' })
  @ApiOkResponse({ type: [RoleResponseDto] })
  async getAllRoles(@Query('search') search?: string): Promise<RoleResponseDto[]> {
    return this.roleService.getAllRoles(search);
  }

  @Get('roles/:id')
  @RequirePermissions(Permission.ROLES_READ)
  @ApiOperation({
    summary: 'Get role details with matrix representation',
    description: 'Route Guard: Protected by JwtAuthGuard + PermissionsGuard requiring [roles:read]. Returns role info, normalized permission keys, and checkbox matrix { module: { read, write, update, delete } }.',
  })
  @ApiParam({ name: 'id', description: 'Role UUID', example: '3fa85f64-5717-4562-b3fc-2c963f66afa6' })
  @ApiOkResponse({ type: RoleDetailResponseDto })
  async getRoleById(@Param('id', new ParseUUIDPipe()) id: string): Promise<RoleDetailResponseDto> {
    return this.roleService.getRoleDetailWithMatrix(id);
  }

  @Post('roles')
  @HttpCode(HttpStatus.CREATED)
  @RequirePermissions(Permission.ROLES_WRITE)
  @ApiOperation({
    summary: 'Create a new role with assigned permissions',
    description: 'Route Guard: Protected by JwtAuthGuard + PermissionsGuard requiring [roles:write]. Creates role and associates permissions via list or matrix.',
  })
  @ApiCreatedResponse({ type: RoleDetailResponseDto })
  async createRole(@Body() dto: CreateRoleDto): Promise<RoleDetailResponseDto> {
    return this.roleService.createRole(dto);
  }

  @Patch('roles/:id')
  @RequirePermissions(Permission.ROLES_UPDATE)
  @ApiOperation({
    summary: 'Update role details and permission matrix',
    description: 'Route Guard: Protected by JwtAuthGuard + PermissionsGuard requiring [roles:update]. Updates name, description, and permission associations. System role slugs are protected.',
  })
  @ApiParam({ name: 'id', description: 'Role UUID', example: '3fa85f64-5717-4562-b3fc-2c963f66afa6' })
  @ApiOkResponse({ type: RoleDetailResponseDto })
  async updateRole(
    @Param('id', new ParseUUIDPipe()) id: string,
    @Body() dto: UpdateRoleDto,
  ): Promise<RoleDetailResponseDto> {
    return this.roleService.updateRole(id, dto);
  }

  @Delete('roles/:id')
  @RequirePermissions(Permission.ROLES_DELETE)
  @ApiOperation({
    summary: 'Delete a custom role',
    description: 'Route Guard: Protected by JwtAuthGuard + PermissionsGuard requiring [roles:delete]. Deletion is blocked if the role is a system role or has users currently assigned.',
  })
  @ApiParam({ name: 'id', description: 'Role UUID', example: '3fa85f64-5717-4562-b3fc-2c963f66afa6' })
  async deleteRole(@Param('id', new ParseUUIDPipe()) id: string) {
    return this.roleService.deleteRole(id);
  }

  // ── User Role Assignment (Single Role per User) ───────────────────────────

  @Get('users/:userId/role')
  @RequirePermissions(Permission.ROLES_READ)
  @ApiOperation({
    summary: 'Get assigned role and permissions for a user',
    description: 'Route Guard: Protected by JwtAuthGuard + PermissionsGuard requiring [roles:read]. Resolves user single assigned role from user_roles and effective permissions.',
  })
  @ApiParam({ name: 'userId', description: 'User UUID', example: '3fa85f64-5717-4562-b3fc-2c963f66afa6' })
  async getUserRole(@Param('userId', new ParseUUIDPipe()) userId: string) {
    const role = await this.roleService.getUserRole(userId);
    const permissions = await this.roleService.getUserPermissions(userId);
    return {
      userId,
      role,
      permissions,
    };
  }

  @Post('users/:userId/role')
  @HttpCode(HttpStatus.OK)
  @RequirePermissions(Permission.USERS_ASSIGN_ROLE)
  @ApiOperation({
    summary: 'Assign or reassign role to a user (enforces exactly 1 role per user)',
    description: 'Route Guard: Protected by JwtAuthGuard + PermissionsGuard requiring [users:assign_role]. Database unique constraint ensures the user has at most one role.',
  })
  @ApiParam({ name: 'userId', description: 'User UUID', example: '3fa85f64-5717-4562-b3fc-2c963f66afa6' })
  async assignUserRole(
    @Param('userId', new ParseUUIDPipe()) userId: string,
    @Body() dto: AssignUserRoleDto,
    @CurrentUser() user: any,
  ) {
    return this.roleService.assignUserRole(userId, dto.roleId, user?.sub);
  }

  @Delete('users/:userId/role')
  @HttpCode(HttpStatus.OK)
  @RequirePermissions(Permission.USERS_ASSIGN_ROLE)
  @ApiOperation({
    summary: 'Revoke assigned role from a user',
    description: 'Route Guard: Protected by JwtAuthGuard + PermissionsGuard requiring [users:assign_role]. Removes assignment from user_roles.',
  })
  @ApiParam({ name: 'userId', description: 'User UUID', example: '3fa85f64-5717-4562-b3fc-2c963f66afa6' })
  async removeUserRole(@Param('userId', new ParseUUIDPipe()) userId: string) {
    await this.roleService.removeUserRole(userId);
    return { success: true, message: 'Role revoked from user' };
  }
}
</file>

<file path="src/modules/authorization/repositories/drizzle-rbac.repository.ts">
// ============================================================================
// Drizzle RBAC Repository — Persistent Role-Based Access Control Storage
// ============================================================================

import { Injectable, Inject, NotFoundException, BadRequestException, ConflictException } from '@nestjs/common';
import { eq, and, or, ilike, sql } from 'drizzle-orm';
import { DRIZZLE, schema } from '@/database';
import { resolvePermissions, normalizePermissionKey, type Scope } from '@/authorization';
import type { DeclaredPermission, SystemRoleDefinition } from '../domain/system-permissions';

type DrizzleDb = any;

export interface RoleWithCounts {
  id: string;
  name: string;
  slug: string;
  description: string | null;
  isSystem: boolean;
  userCount: number;
  permissionCount: number;
  createdAt: Date;
  updatedAt: Date;
}

@Injectable()
export class DrizzleRbacRepository {
  constructor(@Inject(DRIZZLE) private readonly db: DrizzleDb) {}

  // ==========================================================================
  // Synchronization (Bootstrap)
  // ==========================================================================

  async syncDeclaredPermissions(declaredPermissions: DeclaredPermission[]): Promise<void> {
    // Ensure wildcard exists
    await this.db
      .insert(schema.permissions)
      .values({
        moduleName: 'global',
        action: '*',
        permissionKey: '*',
        description: 'Global administrator wildcard access granting all capabilities',
        isActive: true,
      })
      .onConflictDoUpdate({
        target: [schema.permissions.permissionKey],
        set: { isActive: true, updatedAt: new Date() },
      });

    // Bulk upsert declared permissions
    for (const perm of declaredPermissions) {
      await this.db
        .insert(schema.permissions)
        .values({
          moduleName: perm.moduleName,
          action: perm.action,
          permissionKey: perm.permissionKey,
          description: perm.description,
          isActive: true,
        })
        .onConflictDoUpdate({
          target: [schema.permissions.permissionKey],
          set: {
            moduleName: perm.moduleName,
            action: perm.action,
            description: perm.description,
            isActive: true,
            updatedAt: new Date(),
          },
        });
    }
  }

  async syncSystemRoles(systemRoles: SystemRoleDefinition[]): Promise<void> {
    const allDbPermissions = await this.db.select().from(schema.permissions);
    const permMap = new Map<string, string>();
    for (const p of allDbPermissions) {
      permMap.set(p.permissionKey, p.id);
    }

    for (const def of systemRoles) {
      // 1. Upsert role
      const [role] = await this.db
        .insert(schema.roles)
        .values({
          name: def.name,
          slug: def.slug,
          description: def.description,
          isSystem: def.isSystem,
        })
        .onConflictDoUpdate({
          target: [schema.roles.slug],
          set: {
            name: def.name,
            description: def.description,
            isSystem: def.isSystem,
            updatedAt: new Date(),
          },
        })
        .returning();

      if (!role) continue;

      // 2. Map permission keys to IDs
      const targetPermissionIds: string[] = [];
      for (const key of def.permissionKeys) {
        const permId = permMap.get(key);
        if (permId) {
          targetPermissionIds.push(permId);
        }
      }

      // 3. Sync role_permissions (only seed if role has NO existing permissions assigned, protecting admin customizations)
      const existingRolePerms = await this.findPermissionsByRoleId(role.id);
      if (existingRolePerms.length === 0) {
        await this.setRolePermissions(role.id, targetPermissionIds);
      }
    }
  }

  // ==========================================================================
  // Role Queries & Mutations
  // ==========================================================================

  async findAllRoles(search?: string): Promise<RoleWithCounts[]> {
    let query = this.db
      .select({
        id: schema.roles.id,
        name: schema.roles.name,
        slug: schema.roles.slug,
        description: schema.roles.description,
        isSystem: schema.roles.isSystem,
        createdAt: schema.roles.createdAt,
        updatedAt: schema.roles.updatedAt,
      })
      .from(schema.roles);

    if (search && search.trim()) {
      const term = `%${search.trim()}%`;
      query = query.where(
        sql`${schema.roles.name} ILIKE ${term} OR ${schema.roles.slug} ILIKE ${term}`
      );
    }

    const rolesList = await query.orderBy(schema.roles.name);

    // Get counts
    const results: RoleWithCounts[] = [];
    for (const role of rolesList) {
      const [userCountRes] = await this.db
        .select({ count: sql<number>`count(*)::int` })
        .from(schema.userRoles)
        .where(eq(schema.userRoles.roleId, role.id));

      const [permCountRes] = await this.db
        .select({ count: sql<number>`count(*)::int` })
        .from(schema.rolePermissions)
        .where(eq(schema.rolePermissions.roleId, role.id));

      results.push({
        ...role,
        userCount: userCountRes?.count ?? 0,
        permissionCount: permCountRes?.count ?? 0,
      });
    }

    return results;
  }

  async countRoleUsers(roleId: string): Promise<number> {
    const [res] = await this.db
      .select({ count: sql<number>`count(*)::int` })
      .from(schema.userRoles)
      .where(eq(schema.userRoles.roleId, roleId));
    return res?.count ?? 0;
  }

  async findRoleById(id: string) {
    const [role] = await this.db
      .select()
      .from(schema.roles)
      .where(eq(schema.roles.id, id))
      .limit(1);
    return role ?? null;
  }

  async findRoleBySlug(slug: string) {
    const [role] = await this.db
      .select()
      .from(schema.roles)
      .where(eq(schema.roles.slug, slug))
      .limit(1);
    return role ?? null;
  }

  async createRole(data: { name: string; slug: string; description?: string }) {
    const existing = await this.findRoleBySlug(data.slug);
    if (existing) {
      throw new ConflictException(`Role with slug "${data.slug}" already exists`);
    }

    const [role] = await this.db
      .insert(schema.roles)
      .values({
        name: data.name,
        slug: data.slug,
        description: data.description,
        isSystem: false,
      })
      .returning();

    return role;
  }

  async updateRole(id: string, data: { name?: string; slug?: string; description?: string }) {
    const role = await this.findRoleById(id);
    if (!role) {
      throw new NotFoundException(`Role with ID "${id}" not found`);
    }

    if (data.slug && data.slug !== role.slug) {
      const existing = await this.findRoleBySlug(data.slug);
      if (existing && existing.id !== id) {
        throw new ConflictException(`Role with slug "${data.slug}" already exists`);
      }
    }

    const [updated] = await this.db
      .update(schema.roles)
      .set({
        name: data.name ?? role.name,
        slug: data.slug ?? role.slug,
        description: data.description !== undefined ? data.description : role.description,
        updatedAt: new Date(),
      })
      .where(eq(schema.roles.id, id))
      .returning();

    return updated;
  }

  async deleteRole(id: string) {
    const role = await this.findRoleById(id);
    if (!role) {
      throw new NotFoundException(`Role with ID "${id}" not found`);
    }

    if (role.isSystem) {
      throw new BadRequestException(`System role "${role.name}" cannot be deleted`);
    }

    // Check if users are assigned
    const [usersAssigned] = await this.db
      .select({ count: sql<number>`count(*)::int` })
      .from(schema.userRoles)
      .where(eq(schema.userRoles.roleId, id));

    if (usersAssigned && usersAssigned.count > 0) {
      throw new ConflictException(
        `Cannot delete role "${role.name}" because it is currently assigned to ${usersAssigned.count} user(s)`,
      );
    }

    await this.db.delete(schema.roles).where(eq(schema.roles.id, id));
    return { success: true, message: `Role "${role.name}" deleted successfully` };
  }

  // ==========================================================================
  // Permissions Queries
  // ==========================================================================

  async findAllPermissions() {
    return this.db
      .select()
      .from(schema.permissions)
      .where(eq(schema.permissions.isActive, true))
      .orderBy(schema.permissions.moduleName, schema.permissions.action);
  }

  async findPermissionsByRoleId(roleId: string) {
    const rows = await this.db
      .select({
        id: schema.permissions.id,
        moduleName: schema.permissions.moduleName,
        action: schema.permissions.action,
        permissionKey: schema.permissions.permissionKey,
        description: schema.permissions.description,
      })
      .from(schema.rolePermissions)
      .innerJoin(schema.permissions, eq(schema.rolePermissions.permissionId, schema.permissions.id))
      .where(
        and(
          eq(schema.rolePermissions.roleId, roleId),
          eq(schema.permissions.isActive, true),
        ),
      );

    return rows;
  }

  async setRolePermissions(roleId: string, permissionIds: string[]): Promise<void> {
    const role = await this.findRoleById(roleId);
    if (!role) {
      throw new NotFoundException(`Role with ID "${roleId}" not found`);
    }

    // Atomic wipe and re-insert of role permissions
    await this.db.transaction(async (tx: any) => {
      await tx
        .delete(schema.rolePermissions)
        .where(eq(schema.rolePermissions.roleId, roleId));

      if (permissionIds.length > 0) {
        const values = permissionIds.map((pId) => ({
          roleId,
          permissionId: pId,
        }));
        await tx.insert(schema.rolePermissions).values(values);
      }
    });
  }

  // ==========================================================================
  // User Role Assignment (SINGLE ROLE INVARIANT)
  // ==========================================================================

  async assignRoleToUser(userId: string, roleId: string, assignedBy?: string) {
    const role = await this.findRoleById(roleId);
    if (!role) {
      throw new NotFoundException(`Role with ID "${roleId}" not found`);
    }

    const [user] = await this.db
      .select({ id: schema.users.id, email: schema.users.email })
      .from(schema.users)
      .where(eq(schema.users.id, userId))
      .limit(1);

    if (!user) {
      throw new NotFoundException(`User with ID "${userId}" not found`);
    }

    // Atomic upsert: user_roles_user_unique ensures only ONE role per user
    const [assigned] = await this.db
      .insert(schema.userRoles)
      .values({
        userId,
        roleId,
        assignedBy: assignedBy ?? null,
      })
      .onConflictDoUpdate({
        target: [schema.userRoles.userId],
        set: {
          roleId,
          assignedAt: new Date(),
          assignedBy: assignedBy ?? null,
        },
      })
      .returning();

    return {
      userId,
      roleId,
      roleName: role.name,
      roleSlug: role.slug,
      assignedAt: assigned.assignedAt,
    };
  }

  async getUserRole(userId: string) {
    const [userRole] = await this.db
      .select({
        roleId: schema.roles.id,
        roleName: schema.roles.name,
        roleSlug: schema.roles.slug,
        isSystem: schema.roles.isSystem,
        assignedAt: schema.userRoles.assignedAt,
      })
      .from(schema.userRoles)
      .innerJoin(schema.roles, eq(schema.userRoles.roleId, schema.roles.id))
      .where(eq(schema.userRoles.userId, userId))
      .limit(1);

    return userRole ?? null;
  }

  async getUserPermissions(userId: string): Promise<string[]> {
    const userRole = await this.getUserRole(userId);
    if (!userRole) {
      return [];
    }

    // Check if role has wildcard
    const permissions = await this.findPermissionsByRoleId(userRole.roleId);
    const keys = permissions.map((p: any) => p.permissionKey);

    return keys;
  }

  /**
   * Live effective permissions: global role defaults, RBAC user_roles,
   * and active staff_assignment grants. Used so revoked access applies
   * immediately instead of waiting for the JWT to expire.
   */
  async getEffectivePermissions(userId: string): Promise<{
    permissions: string[];
    scopes: Scope[];
  }> {
    const [user] = await this.db
      .select({
        id: schema.users.id,
        role: schema.users.role,
        status: schema.users.status,
      })
      .from(schema.users)
      .where(eq(schema.users.id, userId))
      .limit(1);

    if (!user || (user.status && user.status !== 'ACTIVE')) {
      return { permissions: [], scopes: [] };
    }

    const permissions = new Set<string>(
      resolvePermissions(user.role) as string[],
    );
    const scopes: Scope[] = [];

    if (user.role === 'SUPER_ADMIN') {
      scopes.push({ type: 'global' });
    }

    const ownedOrgs = await this.db
      .select({ id: schema.organizations.id })
      .from(schema.organizations)
      .where(eq(schema.organizations.ownerId, userId));
    for (const org of ownedOrgs) {
      scopes.push({ type: 'organization', id: org.id });
    }

    const rolePerms = await this.getUserPermissions(userId);
    for (const key of rolePerms) {
      permissions.add(key);
    }

    const assignments = await this.db
      .select({
        role: schema.staffAssignments.role,
        permissions: schema.staffAssignments.permissions,
        branchId: schema.staffAssignments.branchId,
        isActive: schema.staffAssignments.isActive,
      })
      .from(schema.staffAssignments)
      .innerJoin(schema.staff, eq(schema.staffAssignments.staffId, schema.staff.id))
      .where(eq(schema.staff.userId, userId));

    for (const assignment of assignments) {
      if (assignment.isActive === false) {
        continue;
      }

      // 1. Resolve dynamic database-backed role permissions for the assigned staff role
      if (assignment.role) {
        const dynamicSlug = assignment.role.toLowerCase().replace(/_/g, '-');
        const roleNameLike = assignment.role.replace(/_/g, ' ');
        try {
          const [dbRole] = await this.db
            .select({ id: schema.roles.id })
            .from(schema.roles)
            .where(
              or(
                eq(schema.roles.slug, dynamicSlug),
                ilike(schema.roles.slug, assignment.role),
                ilike(schema.roles.name, roleNameLike),
              ),
            )
            .limit(1);

          if (dbRole) {
            const dynamicPerms = await this.findPermissionsByRoleId(dbRole.id);
            for (const p of dynamicPerms) {
              permissions.add(p.permissionKey);
              const canonical = normalizePermissionKey(p.permissionKey);
              if (canonical) permissions.add(canonical);
            }
          }
        } catch {
          // Fall back gracefully if role lookup fails
        }
      }

      // 2. Resolve default baseline permissions + explicit permissions
      const resolved = resolvePermissions(
        assignment.role,
        (assignment.permissions as string[]) ?? [],
      ) as string[];
      for (const key of resolved) {
        permissions.add(key);
        const canonical = normalizePermissionKey(key);
        if (canonical) permissions.add(canonical);
      }

      // 3. Include any extra permissions attached to the assignment
      if (Array.isArray(assignment.permissions)) {
        for (const extra of assignment.permissions as string[]) {
          permissions.add(extra);
          const canonical = normalizePermissionKey(extra);
          if (canonical) permissions.add(canonical);
        }
      }

      if (assignment.branchId) {
        scopes.push({ type: 'branch', id: assignment.branchId });
      }
    }

    return {
      permissions: Array.from(permissions),
      scopes,
    };
  }

  async removeUserRole(userId: string): Promise<boolean> {
    const result = await this.db
      .delete(schema.userRoles)
      .where(eq(schema.userRoles.userId, userId));
    return result.rowCount > 0;
  }
}
</file>

