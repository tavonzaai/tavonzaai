<file path="docker/docker-compose.dev.yaml">
services:
  # ─── 1. Web API & Socket.IO Gateway ─────────────────────────────────────
  api:
    build:
      context: ..
      dockerfile: docker/Dockerfile
      target: api
    container_name: tavonzaai-dev-api
    restart: unless-stopped
    ports:
      - "5000:3000"
    env_file:
      - ../.env
    environment:
      PORT: 3000
      API_PORT: 3000
    logging:
      driver: "json-file"
      options:
        max-size: "20m"
        max-file: "3"

  # ─── 2. Background Queue & Outbox Worker ────────────────────────────────
  worker:
    build:
      context: ..
      dockerfile: docker/Dockerfile
      target: worker
    container_name: tavonzaai-dev-worker
    restart: unless-stopped
    env_file:
      - ../.env
    depends_on:
      - api
    logging:
      driver: "json-file"
      options:
        max-size: "20m"
        max-file: "3"

  # ─── 3. Reverse Proxy & SSL ─────────────────────────────────────────────
  caddy:
    image: caddy:2-alpine
    container_name: tavonza-caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_dev_data:/data
      - caddy_dev_config:/config
    env_file:
      - ../.env
    depends_on:
      - api
    logging:
      driver: "json-file"
      options:
        max-size: "20m"
        max-file: "3"

volumes:
  caddy_dev_data:
    name: tavonza_caddy_dev_data
  caddy_dev_config:
    name: tavonza_caddy_dev_config

networks:
  default:
    name: tavonza_dev_network
</file>

<file path="docker/Dockerfile">
ARG BASE_IMAGE=node:20-slim

# --- 1. Base Runtime Layer ---
FROM ${BASE_IMAGE} AS base
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.1.0 --activate

# --- 2. Dependencies Layer ---
FROM base AS dependencies
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile

# --- 3. Build Layer ---
FROM base AS builder
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json tsconfig.json nest-cli.json drizzle.config.ts ./
COPY src/ ./src/
COPY drizzle/ ./drizzle/
RUN pnpm build

# --- 4. Production Runner: Web API & Socket.IO Gateway Target ---
FROM base AS api
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

COPY --chown=node:node --from=builder /app/package.json ./package.json
COPY --chown=node:node --from=dependencies /app/node_modules ./node_modules
COPY --chown=node:node --from=builder /app/dist ./dist
COPY --chown=node:node --from=builder /app/drizzle ./drizzle

USER node
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "require('http').get('http://localhost:' + (process.env.PORT || 3000) + '/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))"

CMD ["node", "dist/src/main.js"]

# --- 5. Production Runner: Background Worker Target ---
FROM base AS worker
WORKDIR /app
ENV NODE_ENV=production

COPY --chown=node:node --from=builder /app/package.json ./package.json
COPY --chown=node:node --from=dependencies /app/node_modules ./node_modules
COPY --chown=node:node --from=builder /app/dist ./dist
COPY --chown=node:node --from=builder /app/drizzle ./drizzle

USER node

CMD ["node", "dist/src/worker.js"]
</file>

<file path=".github/workflows/ci.yml">
name: CI

on:
  pull_request:
    branches: [main, production]

jobs:
  backend-qa:
    name: Backend QA & Build
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Enforce No Forbidden Root Folders
        run: |
          VIOLATIONS=0

          if [ -d ".vscode" ]; then
            echo "::error file=.vscode,title=Forbidden Root Folder::'.vscode' must not be committed."
            VIOLATIONS=1
          fi

          if [ -d "public" ]; then
            echo "::error file=public,title=Forbidden Root Folder::'public' must not exist at the repository root."
            VIOLATIONS=1
          fi

          if [ $VIOLATIONS -ne 0 ]; then
            exit 1
          fi

      - name: Setup Node & pnpm
        uses: ./.github/actions/setup-pnpm

      - name: TypeScript Typecheck
        run: pnpm typecheck

      - name: Drizzle Schema Verification
        run: pnpm drizzle-kit check

      - name: Run Domain & Unit Tests
        run: pnpm test

      - name: Build Dual-Target Application
        run: pnpm build
</file>

