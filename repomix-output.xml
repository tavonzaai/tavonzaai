<file path="src/main.ts">
import { NestFactory } from "@nestjs/core";
import { ValidationPipe } from "@nestjs/common";
import { getCorsConfig, setupSwagger } from "@/config";
import { AppLogger } from "@/infrastructure/observability";
import { AppModule } from "./app.module";
import { HttpLoggerInterceptor } from "./common/interceptors/http-logger.interceptor";
import { AllExceptionsFilter } from "./common/filters/all-exceptions.filter";
import { createValidationException } from "./common/errors/validation-exception.factory";

async function bootstrap() {
  process.env.IS_WORKER = 'false';
  const logger = new AppLogger('Bootstrap');

  const app = await NestFactory.create(AppModule, {
    // Disable NestJS's default logger — we use our own structured one
    logger: false,
    rawBody: true,
  });

  // Enable graceful shutdown hooks (SIGTERM/SIGINT)
  app.enableShutdownHooks();

  // ── Trust Proxy ────────────────────────────────────────────────────────────
  // Ensures Express accurately parses X-Forwarded-For behind ALBs, Cloudflare, and Nginx
  const httpAdapter = app.getHttpAdapter();
  if (httpAdapter && typeof (httpAdapter.getInstance() as any)?.set === 'function') {
    (httpAdapter.getInstance() as any).set('trust proxy', true);
  }

  // ── Global Exception Filter ────────────────────────────────────────────────
  // Must be registered before interceptors so it catches everything
  app.useGlobalFilters(new AllExceptionsFilter());

  // ── Global HTTP Logger ─────────────────────────────────────────────────────
  // Logs every request: method, path, status, duration, IP
  app.useGlobalInterceptors(new HttpLoggerInterceptor());

  // ── CORS Configuration ─────────────────────────────────────────────────────
  app.enableCors(getCorsConfig());

  // ── Global Pipes ───────────────────────────────────────────────────────────
  app.useGlobalPipes(
    new ValidationPipe({
      whitelist: true,
      forbidNonWhitelisted: true,
      transform: true,
      exceptionFactory: createValidationException,
    }),
  );

  // ── Swagger / OpenAPI ──────────────────────────────────────────────────────
  setupSwagger(app);

  const port = process.env.API_PORT || process.env.PORT || 3000;
  const env  = process.env.NODE_ENV || 'development';

  await app.listen(port, '0.0.0.0');

  logger.info(`API server started`, {
    port,
    env,
    swagger: `http://localhost:${port}/docs`,
    pid: process.pid,
  });
}

// Global safety net for unhandled asynchronous errors
process.on('unhandledRejection', (reason: any) => {
  const logger = new AppLogger('Process');
  logger.error('Unhandled Promise Rejection', {
    error: reason?.message || String(reason),
    stack: reason?.stack,
  });
});

process.on('uncaughtException', (err: Error) => {
  const logger = new AppLogger('Process');
  logger.error('Uncaught Exception — initiating graceful exit', {
    error: err.message,
    stack: err.stack,
  });
  process.exit(1);
});

bootstrap().catch((err) => {
  const logger = new AppLogger('Bootstrap');
  logger.error('Fatal error during startup', { error: err?.message, stack: err?.stack });
  process.exit(1);
});
</file>

<file path="drizzle.config.ts">
import { defineConfig } from 'drizzle-kit';
import { config } from 'dotenv';
import { resolve } from 'path';

// Load environment variables from .env
config({ path: resolve(__dirname, '.env') });
config();

const dbUrl = process.env.DATABASE_URL || 'postgresql://postgres:postgres@localhost:5432/platform_dev';

function getDbCredentials() {
  try {
    const parsed = new URL(dbUrl);
    const sslParam = parsed.searchParams.get('ssl');
    const sslMode = parsed.searchParams.get('sslmode');
    const isRds = parsed.hostname.includes('rds.amazonaws.com');
    const isSsl =
      process.env.DATABASE_SSL === 'true' ||
      sslParam === 'true' ||
      (sslMode !== null && sslMode !== 'disable') ||
      isRds;

    if (isSsl) {
      parsed.searchParams.delete('ssl');
      parsed.searchParams.delete('sslmode');
      return {
        host: parsed.hostname,
        port: Number(parsed.port || 5432),
        user: decodeURIComponent(parsed.username),
        password: decodeURIComponent(parsed.password),
        database: parsed.pathname.replace(/^\//, ''),
        ssl: { rejectUnauthorized: false },
      };
    }
  } catch {
    // fallback to url string if URL parsing fails
  }

  return {
    url: dbUrl,
  };
}

export default defineConfig({
  schema: './src/database/schema/index.ts',
  out: './drizzle',
  dialect: 'postgresql',
  dbCredentials: getDbCredentials(),
});
</file>

<file path="src/modules/identity/services/auth.service.ts">
import {
  Injectable,
  Logger,
  BadRequestException,
  UnauthorizedException,
  ConflictException,
  NotFoundException,
  ServiceUnavailableException,
  Optional,
} from '@nestjs/common';
import { JwtService } from '@nestjs/jwt';
import { createHash, randomInt, randomUUID } from 'node:crypto';
import * as argon2 from '@node-rs/argon2';
import { GlobalRole, resolvePermissions, type Scope } from '@/authorization';
import { DrizzleUserRepository } from '../repositories/drizzle-user.repository';
import { DrizzleAuthSessionRepository } from '../repositories/drizzle-auth-session.repository';
import {
  ACCESS_TOKEN_TTL_SECONDS,
  REFRESH_TOKEN_TTL_SECONDS,
  TOKEN_TYPE,
  API_CLIENT,
  accessTokenSecret,
  refreshTokenSecret,
  evaluateRefreshToken,
} from './token-policy';
import { DrizzleRbacRepository } from '../../authorization/repositories/drizzle-rbac.repository';
import { DrizzleOrganizationRepository } from '../../organizations/repositories/drizzle-organization.repository';
import { MailService } from '../../notifications/services/mail.service';
import type {
  RegisterDto,
  LoginDto,
  VerifyOtpDto,
  ForgotPasswordDto,
  ResetPasswordDto,
  ChangePasswordDto,
} from '../dto/auth-request.dto';
import type {
  AuthTokensDto,
  RegisterResponseDto,
  UserProfileDto,
} from '../dto/auth-response.dto';

const OTP_EXPIRY_MINUTES = 10;

export interface SessionContext {
  client?: string;
  userAgent?: string | null;
  ipAddress?: string | null;
}

interface RefreshTokenClaims {
  sub: string;
  sid: string;
  jti: string;
  typ: string;
}

function hashToken(token: string): string {
  return createHash('sha256').update(token).digest('hex');
}

@Injectable()
export class AuthService {
  private readonly logger = new Logger(AuthService.name);

  constructor(
    private readonly userRepo: DrizzleUserRepository,
    private readonly orgRepo: DrizzleOrganizationRepository,
    private readonly jwtService: JwtService,
    private readonly mailService: MailService,
    private readonly sessionRepo: DrizzleAuthSessionRepository,
    @Optional() private readonly rbacRepo?: DrizzleRbacRepository,
  ) {}

  async register(dto: RegisterDto): Promise<RegisterResponseDto> {
    const existing = await this.userRepo.findByEmail(dto.email.toLowerCase());
    if (existing) {
      throw new ConflictException('An account with this email already exists');
    }

    if (dto.phone) {
      const existingPhone = await this.userRepo.findByEmailOrPhone(dto.phone.trim());
      if (existingPhone) {
        throw new ConflictException('This phone number is already in use.');
      }
    }

    this.validatePassword(dto.password);
    const passwordHash = await argon2.hash(dto.password);

    const user = await this.userRepo.create({
      email: dto.email.toLowerCase(),
      passwordHash,
      name: `${dto.firstName.trim()} ${dto.lastName.trim()}`,
      contactNo: dto.phone,
      role: GlobalRole.CUSTOMER,
    });

    await this.generateAndSendOtp(
      user.email,
      'email_verification',
      dto.firstName.trim(),
    );

    return {
      message: 'Account created successfully. Please verify your email with the OTP code sent to your email.',
      email: user.email,
    };
  }

  async login(dto: LoginDto, context: SessionContext = {}): Promise<AuthTokensDto> {
    const user = await this.userRepo.findByEmailOrPhone(dto.email);
    if (!user || user.status !== 'ACTIVE' || !user.password) {
      throw new UnauthorizedException('Invalid email or password');
    }

    const passwordMatch = await argon2.verify(user.password, dto.password);
    if (!passwordMatch) {
      throw new UnauthorizedException('Invalid email or password');
    }

    const sessionId = randomUUID();
    const refreshTokenId = randomUUID();
    const refreshToken = this.signRefreshToken(user.id, sessionId, refreshTokenId);
    await this.sessionRepo.createSessionWithToken({
      sessionId,
      userId: user.id,
      client: context.client ?? API_CLIENT,
      userAgent: context.userAgent,
      ipAddress: context.ipAddress,
      expiresAt: new Date(Date.now() + REFRESH_TOKEN_TTL_SECONDS * 1000),
      refreshTokenId,
      tokenHash: hashToken(refreshToken),
    });

    return this.buildTokens(user, sessionId, refreshToken);
  }

  /**
   * Validates and rotates a refresh token. Replaying a rotated token outside
   * the grace window revokes the whole session (token theft).
   */
  async refreshTokens(refreshToken: string | undefined): Promise<AuthTokensDto> {
    if (!refreshToken) {
      throw new UnauthorizedException('Refresh token is required');
    }

    const claims = this.verifyRefreshToken(refreshToken);
    const found = await this.sessionRepo.findRefreshToken(claims.jti);
    const decision = evaluateRefreshToken({
      record: found?.token ?? null,
      session: found?.session ?? null,
      subject: claims.sub,
      presentedHash: hashToken(refreshToken),
      now: new Date(),
    });

    if (decision.outcome === 'reuse') {
      await this.sessionRepo.revokeSession(claims.sid, 'REUSE_DETECTED');
      this.logger.warn(`Refresh token reuse detected; session ${claims.sid} revoked`);
      throw new UnauthorizedException('Session has been revoked. Please sign in again.');
    }
    if (decision.outcome === 'reject') {
      throw new UnauthorizedException('Invalid or expired refresh token');
    }

    const user = await this.userRepo.findById(claims.sub);
    if (!user || user.status !== 'ACTIVE') {
      await this.sessionRepo.revokeSession(claims.sid, 'ACCOUNT_DISABLED');
      throw new UnauthorizedException('Account is inactive or no longer valid');
    }

    const newId = randomUUID();
    const nextRefreshToken = this.signRefreshToken(user.id, claims.sid, newId);
    const rotated = await this.sessionRepo.rotate({
      oldId: claims.jti,
      sessionId: claims.sid,
      newId,
      newHash: hashToken(nextRefreshToken),
      expiresAt: new Date(Date.now() + REFRESH_TOKEN_TTL_SECONDS * 1000),
    });
    if (!rotated) {
      throw new UnauthorizedException('Invalid or expired refresh token');
    }

    return this.buildTokens(user, claims.sid, nextRefreshToken);
  }

  /** Revokes the session identified by the refresh token or the access token's `sid`. */
  async logout(input: { refreshToken?: string; sessionId?: string; userId?: string }): Promise<void> {
    let sessionId = input.sessionId;
    if (!sessionId && input.refreshToken) {
      try {
        sessionId = this.verifyRefreshToken(input.refreshToken, { ignoreExpiration: true }).sid;
      } catch {
        sessionId = undefined;
      }
    }
    if (!sessionId) return;

    const session = await this.sessionRepo.findSession(sessionId);
    if (!session || (input.userId && session.userId !== input.userId)) return;
    await this.sessionRepo.revokeSession(sessionId, 'LOGOUT');
  }

  async changePassword(userId: string, dto: ChangePasswordDto, currentSessionId?: string): Promise<void> {
    const user = await this.userRepo.findById(userId);
    if (!user || !user.password) {
      throw new BadRequestException('User account not found or has no local password');
    }

    const currentPass = dto.currentPassword || dto.oldPassword;
    if (!currentPass) {
      throw new BadRequestException('Current password is required');
    }

    const match = await argon2.verify(user.password, currentPass);
    if (!match) {
      throw new BadRequestException('Current password does not match');
    }

    this.validatePassword(dto.newPassword);
    const newHash = await argon2.hash(dto.newPassword);
    await this.userRepo.updatePassword(user.id, newHash);
    await this.sessionRepo.revokeAllForUser(user.id, 'PASSWORD_CHANGED', currentSessionId);
  }

  async getMe(userId: string): Promise<UserProfileDto> {
    const user = await this.userRepo.findById(userId);
    if (!user) throw new NotFoundException('User not found');

    const assignments = await this.userRepo.findStaffAssignments(user.id);
    const primaryAssignment = assignments[0];
    const effectiveRole = primaryAssignment?.role || user.role;
    const branchId = primaryAssignment?.branchId ?? null;
    const branchName = primaryAssignment?.branchName ?? null;
    const ownedOrgs = await this.orgRepo.findByOwnerId(user.id);
    const organizationId = ownedOrgs[0]?.id ?? null;

    let permissions: string[] = [];
    let scopes: Scope[] = [];
    if (this.rbacRepo) {
      try {
        const live = await this.rbacRepo.getEffectivePermissions(user.id);
        permissions = live.permissions;
        scopes = live.scopes;
      } catch {
        // Fallback gracefully
      }
    }
    if (permissions.length === 0) {
      permissions = resolvePermissions(
        effectiveRole,
        (primaryAssignment?.permissions as any) ?? [],
      ) as string[];
    }

    return {
      id: user.id,
      email: user.email,
      name: user.name,
      role: effectiveRole,
      globalRole: user.role,
      organizationId,
      branchId,
      branchName,
      assignments,
      permissions,
      scopes,
      phone: user.contactNo ?? null,
      isEmailVerified: user.isEmailVerified,
      createdAt: user.createdAt,
    } as any;
  }

  async verifyOtp(dto: VerifyOtpDto): Promise<void> {
    if (dto.type === 'phone_verification') {
      throw new BadRequestException('Phone verification is not supported');
    }

    const email = dto.email.trim().toLowerCase();
    const otp = await this.userRepo.findValidAuthOtp(email, dto.type);
    if (!otp) throw new BadRequestException('OTP code is invalid or has expired');
    if (otp.otp !== dto.code) throw new BadRequestException('Incorrect verification code');

    if (dto.type === 'email_verification') {
      const consumed = await this.userRepo.consumeAuthOtp(email, dto.type, dto.code);
      if (!consumed) throw new BadRequestException('OTP code is invalid or has expired');
      await this.userRepo.markEmailVerified(email);
    }
  }

  async forgotPassword(dto: ForgotPasswordDto): Promise<void> {
    const user = await this.userRepo.findByEmailOrPhone(dto.email);
    if (!user) return;

    await this.generateAndSendOtp(
      user.email,
      'password_reset',
      user.name.split(' ')[0],
    );
  }

  async resetPassword(dto: ResetPasswordDto): Promise<void> {
    const user = await this.userRepo.findByEmailOrPhone(dto.email);
    if (!user) throw new NotFoundException('User not found');

    const otp = await this.userRepo.findValidAuthOtp(user.email, 'password_reset');
    if (!otp) throw new BadRequestException('OTP code is invalid or has expired');
    if (otp.otp !== dto.code) throw new BadRequestException('Incorrect verification code');

    this.validatePassword(dto.newPassword);
    const newHash = await argon2.hash(dto.newPassword);
    const consumed = await this.userRepo.consumeAuthOtp(
      user.email,
      'password_reset',
      dto.code,
    );
    if (!consumed) throw new BadRequestException('OTP code is invalid or has expired');
    await this.userRepo.updatePassword(user.id, newHash);
    await this.sessionRepo.revokeAllForUser(user.id, 'PASSWORD_CHANGED');
  }

  async resendOtp(
    identifier: string,
    type: 'email_verification' | 'phone_verification' | 'password_reset',
  ): Promise<void> {
    if (type === 'phone_verification') {
      throw new BadRequestException('Phone verification is not supported');
    }
    const user = await this.userRepo.findByEmailOrPhone(identifier);
    if (!user) return;

    await this.generateAndSendOtp(
      user.email,
      type,
      user.name.split(' ')[0],
    );
  }

  private signRefreshToken(userId: string, sessionId: string, tokenId: string): string {
    return this.jwtService.sign(
      { sub: userId, sid: sessionId, typ: TOKEN_TYPE.REFRESH },
      {
        jwtid: tokenId,
        expiresIn: REFRESH_TOKEN_TTL_SECONDS,
        secret: refreshTokenSecret(),
      },
    );
  }

  private verifyRefreshToken(
    token: string,
    options: { ignoreExpiration?: boolean } = {},
  ): RefreshTokenClaims {
    let claims: Partial<RefreshTokenClaims>;
    try {
      claims = this.jwtService.verify(token, {
        secret: refreshTokenSecret(),
        ignoreExpiration: options.ignoreExpiration ?? false,
      });
    } catch {
      throw new UnauthorizedException('Invalid or expired refresh token');
    }
    if (claims.typ !== TOKEN_TYPE.REFRESH || !claims.sub || !claims.sid || !claims.jti) {
      throw new UnauthorizedException('Invalid or expired refresh token');
    }
    return claims as RefreshTokenClaims;
  }

  private async buildTokens(user: any, sessionId: string, refreshToken: string): Promise<AuthTokensDto> {
    let effectiveRole = user.role;
    let effectivePermissions: string[] = [];

    // 1. Resolve dynamic database-backed role & permissions
    if (this.rbacRepo) {
      try {
        const live = await this.rbacRepo.getEffectivePermissions(user.id);
        if (live.permissions.length > 0) {
          effectivePermissions = live.permissions;
        }
        const dynamicRole = await this.rbacRepo.getUserRole(user.id);
        if (dynamicRole) {
          effectiveRole = dynamicRole.roleName.toUpperCase().replace(/\s+/g, '_');
        }
      } catch {
        // Fallback to legacy assignments on error
      }
    }

    // 2. Fallback to branch staff assignments and static role resolutions
    const assignments = await this.userRepo.findStaffAssignments(user.id);
    const primaryAssignment = assignments[0];
    if (!effectivePermissions || effectivePermissions.length === 0) {
      effectiveRole = primaryAssignment?.role || user.role;
      effectivePermissions = resolvePermissions(
        effectiveRole,
        (primaryAssignment?.permissions as any) ?? [],
      ) as string[];
    } else if (primaryAssignment?.role && user.role !== 'SUPER_ADMIN' && user.role !== 'ADMIN') {
      effectiveRole = primaryAssignment.role;
    }

    const branchId = primaryAssignment?.branchId ?? null;
    const branchName = primaryAssignment?.branchName ?? null;
    const ownedOrgs = await this.orgRepo.findByOwnerId(user.id);
    const organizationId = ownedOrgs[0]?.id ?? null;

    const scopes: Scope[] = [];
    if (user.role === GlobalRole.SUPER_ADMIN) {
      scopes.push({ type: 'global' });
    }
    if (organizationId) {
      scopes.push({ type: 'organization', id: organizationId });
    }
    for (const assignment of assignments) {
      if (assignment?.isActive === false || !assignment?.branchId) {
        continue;
      }
      scopes.push({ type: 'branch', id: assignment.branchId });
    }

    const payload = {
      sub: user.id,
      sid: sessionId,
      typ: TOKEN_TYPE.ACCESS,
      email: user.email,
      role: effectiveRole,
      globalRole: user.role,
      organizationId,
      branchId,
      permissions: effectivePermissions,
      scopes,
    };

    const accessToken = this.jwtService.sign(payload, {
      expiresIn: ACCESS_TOKEN_TTL_SECONDS,
      secret: accessTokenSecret(),
    });

    return {
      accessToken,
      refreshToken,
      user: {
        id: user.id,
        email: user.email,
        name: user.name,
        role: effectiveRole,
        globalRole: user.role,
        organizationId,
        branchId,
        branchName,
        assignments,
        permissions: effectivePermissions,
        scopes,
      } as any,
    };
  }

  private async generateAndSendOtp(
    email: string,
    type: 'email_verification' | 'phone_verification' | 'password_reset',
    firstName: string,
  ): Promise<string> {
    if (type === 'phone_verification') {
      throw new BadRequestException('Phone verification is not supported');
    }

    const code = randomInt(10000, 100000).toString();
    const expiresAt = new Date(Date.now() + OTP_EXPIRY_MINUTES * 60 * 1000);

    await this.userRepo.createAuthOtp(email, code, type, expiresAt);

    const mailResult = type === 'password_reset'
      ? await this.mailService.sendPasswordResetCode(email, firstName, code)
      : await this.mailService.sendVerificationCode(email, firstName, code);

    if (!mailResult.success) {
      if (process.env.NODE_ENV !== 'production') {
        this.logger.warn(`Mail delivery failed in dev mode, but OTP was generated: ${code}`);
        return code;
      }
      await this.userRepo.deleteAuthOtp(email, type, code);
      throw new ServiceUnavailableException('Unable to send the OTP email. Please try again.');
    }

    return code;
  }

  private validatePassword(password: string): void {
    if (password.length < 8) {
      throw new BadRequestException('Password must be at least 8 characters');
    }
  }
}
</file>

<file path="src/modules/identity/services/user.service.ts">
// ============================================================================
// User Service — User Profile, Listing, Filtering & Management
// ============================================================================

import {
  Injectable,
  NotFoundException,
  ConflictException,
  ForbiddenException,
  BadRequestException,
  Optional,
} from '@nestjs/common';
import * as argon2 from '@node-rs/argon2';
import { StorageService, generateKey } from '@/infrastructure/storage';
import { actorHoldsPermission, isPrivilegedGlobalRole } from '@/authorization';
import { DrizzleRbacRepository } from '../../authorization/repositories/drizzle-rbac.repository';
import { DrizzleUserRepository } from '../repositories/drizzle-user.repository';
import { DrizzleAuthSessionRepository } from '../repositories/drizzle-auth-session.repository';
import { DrizzleOrganizationRepository } from '../../organizations/repositories/drizzle-organization.repository';
import { isSuperAdmin } from '../../../common/auth/actor.util';
import type { JwtPayload } from '../adapters/jwt.strategy';
import type {
  UpdateUserProfileDto,
  GetUsersFilterDto,
  CreateCustomerUserDto,
  CreateAdminUserDto,
} from '../dto/user-request.dto';
import {
  UserDetailResponseDto,
  UsersListResponseDto,
  MyAssignmentsResponseDto,
} from '../dto/user-response.dto';

@Injectable()
export class UserService {
  constructor(
    private readonly userRepo: DrizzleUserRepository,
    private readonly orgRepo: DrizzleOrganizationRepository,
    private readonly sessionRepo: DrizzleAuthSessionRepository,
    @Optional() private readonly rbacRepo?: DrizzleRbacRepository,
    @Optional() private readonly storageService?: StorageService,
  ) {}

  /**
   * Update the current authenticated user's profile
   */
  async updateMe(
    userId: string,
    dto: UpdateUserProfileDto,
    avatarFile?: Express.Multer.File,
  ): Promise<UserDetailResponseDto> {
    const user = await this.userRepo.findById(userId);
    if (!user) {
      throw new NotFoundException('User not found');
    }

    let avatarUrl = dto.avatar;

    // Handle avatar file upload if uploaded via multipart/form-data
    if (avatarFile && this.storageService) {
      try {
        const key = generateKey('avatars', avatarFile.originalname, {
          folder: `users/${userId}`,
          addTimestamp: true,
          addRandomSuffix: true,
        });

        const uploadRes = await this.storageService.uploadFile({
          key,
          file: avatarFile.buffer,
          contentType: avatarFile.mimetype,
          contentLength: avatarFile.size,
          isPublic: true,
        });

        avatarUrl = uploadRes.location;
      } catch (err: any) {
        throw new BadRequestException(`Failed to upload avatar: ${err.message}`);
      }
    }

    // Contact number conflict check if changing phone number
    const contactNumber = dto.contactNo ?? dto.phone;
    if (contactNumber && contactNumber.trim() !== (user.contactNo ?? '')) {
      const existingPhone = await this.userRepo.findByEmailOrPhone(contactNumber.trim());
      if (existingPhone && existingPhone.id !== userId) {
        throw new ConflictException('This contact number is already in use by another account');
      }
    }

    // Resolve name
    let resolvedName = dto.name;
    if (!resolvedName && (dto.firstName || dto.lastName)) {
      resolvedName = `${dto.firstName ?? ''} ${dto.lastName ?? ''}`.trim();
    }

    await this.userRepo.updateProfile(userId, {
      name: resolvedName,
      contactNo: contactNumber ? contactNumber.trim() : undefined,
      avatar: avatarUrl,
      fcmToken: dto.fcmToken,
    });

    if (dto.defaultAddress) {
      await this.userRepo.updateCustomerProfile(userId, {
        defaultAddress: dto.defaultAddress,
      });
    }

    const updatedUser = await this.userRepo.findByIdWithRelations(userId);
    return this.toUserDetail(updatedUser);
  }

  /**
   * Get current authenticated user profile
   */
  async getMe(userId: string): Promise<UserDetailResponseDto> {
    const user = await this.userRepo.findByIdWithRelations(userId);
    if (!user) {
      throw new NotFoundException('User not found');
    }
    return this.toUserDetail(user);
  }

  /**
   * Get a single user by ID
   */
  async getUserById(targetId: string, currentUser: JwtPayload): Promise<UserDetailResponseDto> {
    // If not self, verify admin/staff reading privileges
    if (currentUser.sub !== targetId && !this.canManageUsers(currentUser)) {
      throw new ForbiddenException('Access denied. You can only view your own profile.');
    }

    const user = await this.userRepo.findByIdWithRelations(targetId);
    if (!user) {
      throw new NotFoundException(`User with ID "${targetId}" not found`);
    }

    await this.assertCanAccessUserRecord(currentUser, user);

    return this.toUserDetail(user);
  }

  /**
   * List all users with filters, search, and pagination
   */
  async getUsers(
    query: GetUsersFilterDto,
    currentUser: JwtPayload,
  ): Promise<UsersListResponseDto> {
    if (!this.canManageUsers(currentUser)) {
      throw new ForbiddenException('Access denied. Administrator or staff permission required.');
    }

    let userIds: string[] | undefined;
    if (!isSuperAdmin(currentUser)) {
      const organizationId = await this.resolveManagedOrganizationId(currentUser);
      userIds = await this.userRepo.findUserIdsForOrganization(organizationId);
    }

    const res = await this.userRepo.findMany({
      page: query.page,
      limit: query.limit,
      search: query.search,
      role: query.role,
      status: query.status,
      sortBy: query.sortBy,
      sortOrder: query.sortOrder,
      userIds,
    });

    return {
      data: res.data.map((u: any) => UserDetailResponseDto.fromRecord(u, u.customer)),
      meta: res.meta,
    };
  }

  /**
   * Toggle or update user status (ACTIVE / INACTIVE / BANNED / DELETED)
   */
  async changeStatus(
    targetId: string,
    status: string | undefined,
    currentUser: JwtPayload,
  ): Promise<UserDetailResponseDto> {
    if (!isPrivilegedGlobalRole(currentUser.globalRole) && !isPrivilegedGlobalRole(currentUser.role)) {
      throw new ForbiddenException('Access denied. Administrator permission required.');
    }

    const targetUser = await this.userRepo.findById(targetId);
    if (!targetUser) {
      throw new NotFoundException(`User with ID "${targetId}" not found`);
    }

    await this.assertCanAccessUserRecord(currentUser, targetUser);

    if (targetUser.role === 'SUPER_ADMIN' && currentUser.role !== 'SUPER_ADMIN') {
      throw new ForbiddenException('Cannot modify status of a SUPER_ADMIN account');
    }

    if (targetId === currentUser.sub && status && status !== 'ACTIVE') {
      throw new ForbiddenException('You cannot deactivate your own account');
    }

    await this.userRepo.updateStatus(targetId, status);
    if (status && status !== 'ACTIVE') {
      await this.sessionRepo.revokeAllForUser(targetId, 'ACCOUNT_DISABLED');
    }
    const updated = await this.userRepo.findByIdWithRelations(targetId);
    return UserDetailResponseDto.fromRecord(updated, updated.customer, updated.assignments);
  }

  /**
   * Soft delete user account by setting status to DELETED
   */
  async softDelete(targetId: string, currentUser: JwtPayload): Promise<UserDetailResponseDto> {
    return this.changeStatus(targetId, 'DELETED', currentUser);
  }

  /**
   * Create a customer user account
   */
  async createCustomer(dto: CreateCustomerUserDto): Promise<UserDetailResponseDto> {
    const existingEmail = await this.userRepo.findByEmail(dto.email.toLowerCase().trim());
    if (existingEmail) {
      throw new ConflictException('An account with this email already exists');
    }

    if (dto.contactNo) {
      const existingPhone = await this.userRepo.findByEmailOrPhone(dto.contactNo.trim());
      if (existingPhone) {
        throw new ConflictException('This contact number is already registered');
      }
    }

    this.validatePassword(dto.password);
    const passwordHash = await argon2.hash(dto.password);

    const created = await this.userRepo.create({
      email: dto.email.toLowerCase().trim(),
      passwordHash,
      name: dto.name.trim(),
      contactNo: dto.contactNo ? dto.contactNo.trim() : undefined,
      avatar: dto.avatar,
      role: 'CUSTOMER',
    });

    if (dto.customer) {
      await this.userRepo.updateCustomerProfile(created.id, {
        defaultAddress: dto.customer.defaultAddress,
        loyaltyPoints: dto.customer.loyaltyPoints ?? 0,
      });
    }

    const userWithRelations = await this.userRepo.findByIdWithRelations(created.id);
    return UserDetailResponseDto.fromRecord(
      userWithRelations,
      userWithRelations.customer,
      userWithRelations.assignments,
    );
  }

  /**
   * Create an admin user account (SUPER_ADMIN only)
   */
  async createAdmin(
    dto: CreateAdminUserDto,
    currentUser: JwtPayload,
  ): Promise<UserDetailResponseDto> {
    if (currentUser.role !== 'SUPER_ADMIN') {
      throw new ForbiddenException('Only SUPER_ADMIN can create administrator accounts');
    }

    const existingEmail = await this.userRepo.findByEmail(dto.email.toLowerCase().trim());
    if (existingEmail) {
      throw new ConflictException('An account with this email already exists');
    }

    if (dto.contactNo) {
      const existingPhone = await this.userRepo.findByEmailOrPhone(dto.contactNo.trim());
      if (existingPhone) {
        throw new ConflictException('This contact number is already registered');
      }
    }

    this.validatePassword(dto.password);
    const passwordHash = await argon2.hash(dto.password);

    const created = await this.userRepo.createAdmin({
      email: dto.email.toLowerCase().trim(),
      passwordHash,
      name: dto.name.trim(),
      contactNo: dto.contactNo ? dto.contactNo.trim() : undefined,
      avatar: dto.avatar,
    });

    const userWithRelations = await this.userRepo.findByIdWithRelations(created.id);
    return UserDetailResponseDto.fromRecord(
      userWithRelations,
      userWithRelations.customer,
      userWithRelations.assignments,
    );
  }

  /**
   * Get staff assignments for the current authenticated user
   */
  async getMyAssignments(userId: string): Promise<MyAssignmentsResponseDto> {
    const staff = await this.userRepo.findStaffProfileByUserId(userId);
    const assignments = await this.userRepo.findStaffAssignments(userId);
    return {
      staffId: staff?.id || (assignments[0] as any)?.staffId || null,
      assignments: assignments as any,
    };
  }

  private async toUserDetail(user: any): Promise<UserDetailResponseDto> {
    let permissions: string[] | undefined = undefined;
    let scopes: any[] | undefined = undefined;
    if (this.rbacRepo) {
      try {
        const live = await this.rbacRepo.getEffectivePermissions(user.id);
        permissions = live.permissions;
        scopes = live.scopes;
      } catch {
        // Fall back gracefully if live lookup fails
      }
    }
    const dto = UserDetailResponseDto.fromRecord(
      user,
      user.customer,
      user.assignments,
      permissions,
      scopes,
    );
    if (user.role === 'ADMIN' || user.role === 'RESTAURANT_OWNER') {
      const owned = await this.orgRepo.findByOwnerId(user.id);
      dto.organizationId = owned[0]?.id ?? null;
    }
    return dto;
  }

  private canManageUsers(currentUser: JwtPayload): boolean {
    return (
      isSuperAdmin(currentUser) ||
      isPrivilegedGlobalRole(currentUser.globalRole) ||
      isPrivilegedGlobalRole(currentUser.role) ||
      actorHoldsPermission(currentUser.permissions ?? [], 'users:read') ||
      actorHoldsPermission(currentUser.permissions ?? [], 'staff:read') ||
      actorHoldsPermission(currentUser.permissions ?? [], 'staff:manage')
    );
  }

  private async resolveManagedOrganizationId(currentUser: JwtPayload): Promise<string> {
    if (currentUser.organizationId) {
      return currentUser.organizationId;
    }
    const owned = await this.orgRepo.findByOwnerId(currentUser.sub);
    const organizationId = owned[0]?.id;
    if (!organizationId) {
      throw new ForbiddenException('No organization is associated with this account');
    }
    return organizationId;
  }

  private async assertCanAccessUserRecord(
    currentUser: JwtPayload,
    target: { id: string; role?: string },
  ): Promise<void> {
    if (isSuperAdmin(currentUser) || currentUser.sub === target.id) {
      return;
    }

    const organizationId = await this.resolveManagedOrganizationId(currentUser);
    const scopedIds = await this.userRepo.findUserIdsForOrganization(organizationId);
    if (!scopedIds.includes(target.id)) {
      throw new ForbiddenException('You do not have access to this user');
    }
  }

  private validatePassword(password: string): void {

    if (!password || password.length < 8) {
      throw new BadRequestException('Password must be at least 8 characters long');
    }
  }
}
</file>

