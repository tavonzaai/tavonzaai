  private async resolveUniqueSlug(baseSlug: string): Promise<string> {
    let slug = baseSlug;
    let attempt = 0;
    while (await this.restaurantRepo.findBySlug(slug)) {
      attempt++;
      slug = `${baseSlug}-${Math.random().toString(36).substring(2, 6)}`;
      if (attempt > 10) break;
