  console.log('✓ Seeded Waiter Marco and Table 4 assignment.');

  // 2. Test Login as Waiter
  const loginRes = await fetch(`${API_URL}/auth/login`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
