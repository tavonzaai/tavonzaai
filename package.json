{
  "name": "tavonza-backend",
  "version": "1.0.0",
  "description": "Tavonza AI Enterprise Multi-Tenant Restaurant SaaS Platform Backend",
  "private": true,
  "author": "Tavonza AI Engineering",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "start:worker:dev": "tsx watch src/worker.ts",
    "dev": "nest start --watch",
    "dev:worker": "tsx watch src/worker.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "clean": "rm -rf dist .turbo",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/database/seed.ts",
    "db:reset": "tsx src/database/reset.ts",
    "docker:up": "docker compose -f docker/docker-compose.dev.yaml up -d",
    "docker:down": "docker compose -f docker/docker-compose.dev.yaml down",
    "docker:logs": "docker compose -f docker/docker-compose.dev.yaml logs -f"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-sesv2": "^3.1144.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@aws-sdk/s3-presigned-post": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@nestjs/common": "^10.3.8",
    "@nestjs/core": "^10.3.8",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/platform-socket.io": "^10.3.8",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/websockets": "^10.3.8",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "drizzle-seed": "^0.3.1",
    "drizzle-zod": "^0.8.3",
    "ioredis": "^6.0.0",
    "mime-types": "^3.0.2",
    "nodemailer": "^10.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "stripe": "^23.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.8",
    "@types/express": "^4.17.21",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.6",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
