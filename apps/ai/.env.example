# Tavonza AI Service — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit a filled .env to version control.

ENVIRONMENT=dev
AI_SERVICE_NAME=tavonza-ai
AI_AGENT_DEFAULT_ID=waiter_ai_v1
AI_SERVICE_PORT=8000

# -----------------------------------------------------------------------
# Backend Tool Gateway Connection (apps/api REST API)
# -----------------------------------------------------------------------
# Base URL of the backend's /internal or tool gateway routes
# Example: http://localhost:3000/internal  (local dev)
#          http://localhost:3000           (tool gateway root)
INTERNAL_API_BASE_URL=http://localhost:3000/internal

# Shared secret token for platform authentication
INTERNAL_API_SERVICE_TOKEN=replace-with-shared-secret-agreed-with-backend-team

# -----------------------------------------------------------------------
# Model Provider: Groq
# -----------------------------------------------------------------------
# Get your API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------
# Alternative Model Providers (Optional)
# -----------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------
# Cache / Conversation Memory
# -----------------------------------------------------------------------
# Redis is recommended for production (multiple workers / process restarts).
# In dev without Redis, store falls back to in-memory automatically.
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------
# Security & Network
# -----------------------------------------------------------------------
# Comma-separated allowed CORS origins. Never use * in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------
# Developer Flags — MUST be false in production
# -----------------------------------------------------------------------
# true  = AI runs on local fixture data (no backend needed) — FOR DEV ONLY
# false = AI connects to real backend via INTERNAL_API_BASE_URL
DEV_MODE_MOCK_BACKEND=true

LOG_LEVEL=info
