{
  "name": "@tavonza/api",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "dotenv -e ../../.env -- nest start",
    "dev": "pnpm --filter @tavonza/database db:generate && dotenv -e ../../.env -- nest start --watch",
    "db:push": "pnpm --filter @tavonza/database db:push",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/modules/branches/domain/staff-list-filter.spec.ts src/modules/orders/domain/cart-rules.spec.ts src/modules/orders/domain/order-access.spec.ts src/modules/identity/domain/token-policy.spec.ts src/modules/authorization/application/branch-access.policy.spec.ts src/modules/table-sessions/domain/session-access.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.8",
    "@nestjs/core": "^10.3.8",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/platform-socket.io": "^10.3.8",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/websockets": "^10.3.8",
    "@tavonza/authorization": "workspace:*",
    "@tavonza/config": "workspace:*",
    "@tavonza/contracts": "workspace:*",
    "@tavonza/database": "workspace:*",
    "@tavonza/events": "workspace:*",
    "@tavonza/observability": "workspace:*",
    "@tavonza/queue": "workspace:*",
    "@tavonza/shared": "workspace:*",
    "@tavonza/storage": "workspace:*",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.31.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "stripe": "^23.0.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.8",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.12.7",
    "@types/passport-jwt": "^4.0.1",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  }
}
